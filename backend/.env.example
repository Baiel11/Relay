# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/relay

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=replace-with-a-strong-random-string
JWT_REFRESH_SECRET_KEY=replace-with-a-different-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Application
APP_NAME=Relay
DEBUG=true